# Railway tarball ignore — utilisé avec `railway up --no-gitignore` pour
# embarquer `data/processed/formations.json` (gitignored mais nécessaire au
# runtime) tout en filtrant les gros artefacts qui blow up le payload upload.
#
# Limite Cloudflare : ~100 MB body. Sans cet ignore, le tarball fait 2.7 GB.
# Avec : on cible ~600 MB (formations.json 104 MB + src/ + requirements.lock +
# deps Docker layers downloaded à part).

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data raw / golden_qa / annexes — pas runtime-needed
data/raw/
data/golden_qa/

# Option C (ordre 1535) — index + quads + manifest EMBARQUÉS dans l'image (volume
# Railway abandonné). On exclut data/embeddings/* (backups, checkpoints, rollback,
# vieux index) SAUF les 7 artefacts servis. glob+négation (gitignore-style ne
# ré-inclut pas sous un dir exclu). ~+412MB au tarball railway up (index 213 + quads 196).
data/embeddings/*
!data/embeddings/formations.index
!data/embeddings/formations_v7_formations.index
!data/embeddings/formations_v7_metiers.index
!data/embeddings/formations_v7_statistiques.index
!data/embeddings/formations_v7_aides_territoires.index
!data/embeddings/formations_partition_manifest.json
!data/embeddings/golden_qa.index
